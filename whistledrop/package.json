{
  "name": "whistledrop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && node scripts/copy-swagger-ui.mjs",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "seed:demo": "dotenv -e .env.local -- tsx --conditions=react-server prisma/seed-demo.ts",
    "account:deactivate": "dotenv -e .env.local -- tsx scripts/deactivate-account.ts",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:db:up": "docker compose -f compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f compose.test.yml down",
    "storage:setup": "dotenv -e .env.local -- tsx --conditions=react-server scripts/setup-storage.ts",
    "env:check": "dotenv -e .env.local -- tsx scripts/check-env.ts",
    "test:e2e": "next build && vitest run --project e2e",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "screenshots": "next build && dotenv -e .env.local -- node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "2.117.1",
    "@upstash/ratelimit": "2.1.0",
    "@upstash/redis": "1.39.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "swagger-ui-dist": "5.33.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
