generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// PRIVACY: Report, StatusUpdate and CaseMessage must never hold data that could
// identify a reporter (no IP, IP hash, session ID, device fingerprint, email,
// user agent, etc.).

enum ReportCategory {
  SECURITY
  HARASSMENT
  CORRUPTION
  TECHNICAL
  OTHER
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  /// Terminal and read-only; evidence files are purged on entry.
  CLOSED
}

enum NoteVisibility {
  /// Shown to the reporter through the case-code lookup.
  PUBLIC
  /// Moderators only.
  INTERNAL
}

enum ModeratorRole {
  ADMIN
  MODERATOR
}

enum MessageAuthorType {
  /// The anonymous reporter, through the case code.
  REPORTER
  /// A moderator; shown to the reporter only as "REVIEW_TEAM".
  MODERATOR
}

model Report {
  /// Internal only — never expose to reporters; they use caseCode.
  id            String         @id @default(cuid())
  /// Unique constraint also creates the lookup index.
  caseCode      String         @unique
  category      ReportCategory
  /// Length (20–5000) is validated at the API layer.
  description   String
  evidenceUrl   String?
  status        ReportStatus   @default(SUBMITTED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  /// Set when the report moves to CLOSED.
  closedAt      DateTime?
  /// True while the reporter's latest message has no moderator reply. Set in
  /// the same transaction as each message; cleared when the case closes.
  awaitingReply Boolean        @default(false)
  statusUpdates StatusUpdate[]
  attachments   Attachment[]
  messages      CaseMessage[]
  internalNotes InternalNote[]

  @@index([awaitingReply])
}

model StatusUpdate {
  id          String         @id @default(cuid())
  reportId    String
  report      Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  note        String?
  visibility  NoteVisibility @default(PUBLIC)
  newStatus   ReportStatus
  /// Acting moderator. Optional only so rows written before the audit trail
  /// existed stay valid; every new update sets it. Restrict: moderators with
  /// history are deactivated, never deleted, so the trail can't be erased.
  moderatorId String?
  moderator   Moderator?     @relation(fields: [moderatorId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())

  @@index([reportId])
  @@index([moderatorId])
}

model Moderator {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          ModeratorRole  @default(MODERATOR)
  /// Checked on every authenticated request, so deactivation is immediate.
  isActive      Boolean        @default(true)
  /// Public demo account (credentials in DUMMY_SIGN_INS.txt). Its role and
  /// active status can't be changed through the API, it can't change other
  /// accounts' role or status, and the daily cron restores it.
  isDemo        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  statusUpdates StatusUpdate[]
  caseMessages  CaseMessage[]
  internalNotes InternalNote[]
}

/// The conversation between the reporter and the review team. Visible to the
/// reporter (moderators appear only as "REVIEW_TEAM"). Holds nothing about the
/// reporter: no IP, no hash, no user agent.
model CaseMessage {
  id          String            @id @default(cuid())
  reportId    String
  report      Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorType  MessageAuthorType
  /// Set only for MODERATOR messages (a CHECK constraint enforces it).
  /// Restrict, like StatusUpdate: the staff trail can't be erased.
  moderatorId String?
  moderator   Moderator?        @relation(fields: [moderatorId], references: [id], onDelete: Restrict)
  body        String
  createdAt   DateTime          @default(now())

  @@index([reportId, createdAt])
  @@index([moderatorId])
}

/// Staff-only note on a case. Never visible to the reporter.
model InternalNote {
  id          String    @id @default(cuid())
  reportId    String
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  moderatorId String
  moderator   Moderator @relation(fields: [moderatorId], references: [id], onDelete: Restrict)
  body        String
  createdAt   DateTime  @default(now())

  @@index([reportId, createdAt])
  @@index([moderatorId])
}

/// Evidence file in the private Supabase Storage bucket. Only files that passed
/// type/size checks (and, for images, metadata stripping) get a row.
model Attachment {
  id          String   @id @default(cuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Object path inside the bucket: reports/<reportId>/<attachmentId>.<ext>
  storagePath String   @unique
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([reportId])
}

/// Upload tokens already used in a submission, so a token can't attach the same
/// file twice. Holds only the token's random id: nothing about the uploader.
model ConsumedUploadToken {
  jti        String   @id
  consumedAt DateTime @default(now())
}
