# Copy to .env.local and fill in real values. Never commit .env.local.

# Transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) — used by Prisma Migrate.
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET="replace-me"

# Initial ADMIN account, created by `npm run db:seed`.
SEED_MODERATOR_EMAIL="moderator@example.com"
SEED_MODERATOR_PASSWORD="replace-me"

# Keys the daily-rotating HMAC of client IPs used for rate limiting (never
# stored anywhere else). At least 32 characters: `openssl rand -base64 48`
IP_HASH_SECRET="replace-me"

# Supabase Storage (private "evidence" bucket). Server-only: never prefix these
# with NEXT_PUBLIC_. Dashboard > Project Settings > API.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-me"

# Upstash Redis for rate limiting (required in production; tests use an
# in-memory limiter, and local dev falls back to it with a warning if unset).
# The Vercel Upstash integration's KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL="https://[name].upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# Optional: integration tests use a local Docker Postgres by default
# (compose.test.yml). Must be a local database whose name ends in _test.
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/whistledrop_test"
